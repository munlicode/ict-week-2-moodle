---
// RightColumn.astro — Recently accessed items & My courses sidebar blocks
import { myCourses } from "../data/mockData";

interface Props {
  siteUrl?: string;
}

const { siteUrl = "" } = Astro.props;
---

<!-- ── RIGHT COLUMN: Recently accessed & My Course List ──────── -->
<div class="columnright blockcolumn has-blocks">
  <div data-region="blocks-column" class="d-print-none">
    <aside
      id="block-region-side-post"
      class="block-region"
      data-blockregion="side-post"
      data-droptarget="1"
      aria-labelledby="side-post-block-region-heading"
    >
      <h2 class="visually-hidden" id="side-post-block-region-heading">
        Supplementary blocks
      </h2>

      <span id="sb-4"></span>
      <a href="#sb-5" class="visually-hidden-focusable">Skip Course overview</a>

      <!-- ── My Courses Block ───────────────────────────────────── -->
      <section
        id="inst42815"
        class="block_course_list block card mb-3"
        role="region"
        data-block="course_list"
        data-instance-id="42815"
        aria-labelledby="instance-42815-header"
      >
        <div class="card-body p-3">
          <div class="d-flex">
            <h3 id="instance-42815-header" class="h5 card-title">My courses</h3>
          </div>
          <div class="card-text content mt-3">
            <ul class="list-unstyled">
              {
                myCourses.map((course) => (
                  <li class="mb-2">
                    <a href={`${siteUrl}/course/view.php?id=${course.id}`}>
                      {course.name} | {course.instructor}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="footer border-top pt-2">
              <a href={`${siteUrl}/my-courses`}>All courses</a>
            </div>
          </div>
        </div>
      </section>
      <span id="sb-5"></span>
    </aside>
  </div>
</div>
