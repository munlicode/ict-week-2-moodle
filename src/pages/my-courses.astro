---
// pages/my-courses.astro
// My courses page extracted from My courses | frontpage.html
// Uses Layout.astro which supplies Navbar, PageHeader, and Footer.

import Layout from "../layouts/Layout.astro";
import LeftColumn from "../components/LeftColumn.astro";
import RightColumn from "../components/RightColumn.astro";
import { myCourses } from "../data/mockData";
import QuickLinks from "../components/QuickLinks.astro";

const siteUrl = "";
const sesskey = "OYML9ERAvF";
---

<Layout
  title="My courses | frontpage"
  pageTitle="My courses"
  breadcrumbs={[
    { label: "Home", href: "/", current: false },
    { label: "My courses", href: "/my-courses", current: true },
  ]}
>
  <!-- ── MAIN REGION: My Courses & Core Overview Blocks ───────────────────────── -->
  <div id="region-main-box" class="region-main">
    <div id="region-main" class="region-main-content">
      <span class="notifications" id="user-notifications"></span>
      <div role="main">
        <span id="maincontent"></span>
        <section
          id="block-region-content"
          class="block-region"
          data-blockregion="content"
          data-droptarget="1"
          aria-labelledby="content-block-region-heading"
        >
          <h2 class="visually-hidden" id="content-block-region-heading">
            Main content blocks
          </h2>
          <a href="#sb-3" class="visually-hidden-focusable"
            >Skip Course overview</a
          >

          <!-- ── Course Overview Block ─────────────────────────────────── -->
          <section
            id="inst5"
            class="block_myoverview block card mb-3"
            role="region"
            data-block="myoverview"
            data-instance-id="5"
            aria-labelledby="instance-5-header"
          >
            <div class="card-body p-3">
              <div class="d-flex">
                <h3 id="instance-5-header" class="h5 card-title">
                  Course overview
                </h3>
              </div>

              <div class="card-text content mt-3">
                <div
                  id="block-myoverview-courses"
                  class="block-myoverview block-cards"
                  data-region="myoverview"
                >
                  <div
                    role="search"
                    data-region="filter"
                    class="d-flex align-items-center my-2"
                    aria-label="Course overview controls"
                  >
                    <div
                      class="d-flex flex-wrap gap-1 align-items-center w-100"
                    >
                      <!-- Grouping Filter Dropdown -->
                      <div class="dropdown mb-1 me-1">
                        <button
                          id="groupingdropdown"
                          type="button"
                          class="btn btn-outline-secondary dropdown-toggle"
                          data-bs-toggle="dropdown"
                          aria-haspopup="true"
                          aria-expanded="false"
                          aria-label="Grouping drop-down menu"
                        >
                          <span
                            data-active-item-text
                            id="grouping-selected-text">All</span
                          >
                        </button>
                        <ul
                          class="dropdown-menu"
                          role="menu"
                          data-show-active-item
                          data-skip-active-class="true"
                          aria-labelledby="groupingdropdown"
                        >
                          <li>
                            <a
                              class="dropdown-item active"
                              href="#"
                              data-filter="grouping"
                              data-value="all"
                              data-pref="all"
                              aria-label="Show all courses except courses removed from view"
                              role="menuitem"
                              aria-current="true"
                            >
                              All
                            </a>
                          </li>
                          <li class="dropdown-divider" role="presentation">
                            <span class="filler">&nbsp;</span>
                          </li>
                          <li>
                            <a
                              class="dropdown-item"
                              href="#"
                              data-filter="grouping"
                              data-value="inprogress"
                              data-pref="inprogress"
                              aria-label="Show courses in progress"
                              role="menuitem"
                            >
                              In progress
                            </a>
                          </li>
                          <li>
                            <a
                              class="dropdown-item"
                              href="#"
                              data-filter="grouping"
                              data-value="future"
                              data-pref="future"
                              aria-label="Show future courses"
                              role="menuitem"
                            >
                              Future
                            </a>
                          </li>
                          <li>
                            <a
                              class="dropdown-item"
                              href="#"
                              data-filter="grouping"
                              data-value="past"
                              data-pref="past"
                              aria-label="Show past courses"
                              role="menuitem"
                            >
                              Past
                            </a>
                          </li>
                          <li class="dropdown-divider" role="presentation">
                            <span class="filler">&nbsp;</span>
                          </li>
                          <li>
                            <a
                              class="dropdown-item"
                              href="#"
                              data-filter="grouping"
                              data-value="favourites"
                              data-pref="favourites"
                              aria-label="Show starred courses only"
                              role="menuitem"
                            >
                              Starred
                            </a>
                          </li>
                          <li class="dropdown-divider" role="presentation">
                            <span class="filler">&nbsp;</span>
                          </li>
                          <li>
                            <a
                              class="dropdown-item"
                              href="#"
                              data-filter="grouping"
                              data-value="hidden"
                              data-pref="hidden"
                              aria-label="Show courses removed from view"
                              role="menuitem"
                            >
                              Removed from view
                            </a>
                          </li>
                        </ul>
                      </div>

                      <!-- Search Input -->
                      <div class="mb-1 me-1 flex-grow-1">
                        <div
                          id="searchform-auto-mycourses"
                          class="d-flex flex-wrap align-items-center simplesearchform"
                        >
                          <div class="input-group searchbar w-100">
                            <label
                              for="searchinput-mycourses"
                              id="searchinput-label-mycourses"
                              class="visually-hidden"
                            >
                              Search courses
                            </label>
                            <input
                              type="text"
                              data-region="input"
                              data-action="search"
                              id="searchinput-mycourses"
                              class="form-control withclear rounded"
                              placeholder="Search"
                              name="search"
                              value=""
                              autocomplete="off"
                            />
                            <button
                              class="btn btn-clear d-none"
                              id="clear-search-btn"
                              data-action="clearsearch"
                              type="button"
                            >
                              <i
                                class="icon fa fa-xmark fa-fw"
                                aria-hidden="true"></i>
                              <span class="visually-hidden"
                                >Clear search input</span
                              >
                            </button>
                          </div>
                        </div>
                      </div>

                      <!-- Sorting Dropdown -->
                      <div
                        class="mb-1 me-1 d-flex flex-wrap align-items-center"
                      >
                        <div class="dropdown">
                          <button
                            id="sortingdropdown"
                            type="button"
                            class="btn btn-outline-secondary dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-label="Sorting drop-down menu"
                          >
                            <span
                              data-active-item-text
                              id="sorting-selected-text"
                            >
                              Sort by course name
                            </span>
                          </button>
                          <ul
                            class="dropdown-menu"
                            role="menu"
                            data-show-active-item
                            data-skip-active-class="true"
                            aria-labelledby="sortingdropdown"
                          >
                            <li>
                              <a
                                class="dropdown-item active"
                                href="#"
                                data-filter="sort"
                                data-pref="title"
                                data-value="fullname"
                                role="menuitem"
                                aria-current="true"
                              >
                                Sort by course name
                              </a>
                            </li>
                            <li>
                              <a
                                class="dropdown-item"
                                href="#"
                                data-filter="sort"
                                data-pref="lastaccessed"
                                data-value="ul.timeaccess desc"
                                role="menuitem"
                              >
                                Sort by last accessed
                              </a>
                            </li>
                            <li>
                              <a
                                class="dropdown-item"
                                href="#"
                                data-filter="sort"
                                data-pref="startdate"
                                data-value="startdate"
                                role="menuitem"
                              >
                                Sort by start date
                              </a>
                            </li>
                          </ul>
                        </div>
                      </div>

                      <!-- Display Dropdown -->
                      <div class="dropdown mb-1">
                        <button
                          id="displaydropdown"
                          type="button"
                          class="btn btn-outline-secondary dropdown-toggle"
                          data-bs-toggle="dropdown"
                          aria-haspopup="true"
                          aria-expanded="false"
                          aria-label="Display drop-down menu"
                        >
                          <span data-active-item-text id="display-selected-text"
                            >Card</span
                          >
                        </button>
                        <ul
                          class="dropdown-menu"
                          role="menu"
                          data-show-active-item
                          data-skip-active-class="true"
                          aria-labelledby="displaydropdown"
                        >
                          <li>
                            <a
                              class="dropdown-item active"
                              href="#"
                              data-display-option="display"
                              data-value="card"
                              data-pref="card"
                              aria-label="Switch to card view"
                              role="menuitem"
                              aria-current="true"
                            >
                              Card
                            </a>
                          </li>
                          <li>
                            <a
                              class="dropdown-item"
                              href="#"
                              data-display-option="display"
                              data-value="list"
                              data-pref="list"
                              aria-label="Switch to list view"
                              role="menuitem"
                            >
                              List
                            </a>
                          </li>
                          <li>
                            <a
                              class="dropdown-item"
                              href="#"
                              data-display-option="display"
                              data-value="summary"
                              data-pref="summary"
                              aria-label="Switch to summary view"
                              role="menuitem"
                            >
                              Summary
                            </a>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>

                  <!-- Course Cards Container -->
                  <div class="container-fluid p-0">
                    <div
                      id="courses-view-container"
                      data-region="courses-view"
                      data-display="card"
                      data-grouping="all"
                      data-sort="fullname"
                      data-totalcoursecount={myCourses.length}
                    >
                      <div data-region="course-view-content">
                        <div
                          id="courses-cards-grid"
                          class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mt-2"
                        >
                          {
                            myCourses.map((course) => (
                              <div
                                class="col d-flex course-card-item"
                                data-course-name={course.name.toLowerCase()}
                                data-course-instructor={course.instructor.toLowerCase()}
                              >
                                <div class="card dashboard-card w-100 shadow-sm border">
                                  <div
                                    class="card-img-top text-white d-flex align-items-center justify-content-center"
                                    style="height: 7rem; background: linear-gradient(135deg, #0f2b48 0%, #1e5799 100%);"
                                  >
                                    <i
                                      class="fa fa-graduation-cap fa-2x opacity-75"
                                      aria-hidden="true"
                                    />
                                  </div>
                                  <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div>
                                      <div class="text-muted small mb-1">
                                        2026-2027-1
                                      </div>
                                      <h4 class="h6 card-title mb-2">
                                        <a
                                          href={`${siteUrl}/course/view.php?id=${course.id}`}
                                          class="text-decoration-none text-dark font-weight-bold"
                                        >
                                          {course.name} | {course.instructor}
                                        </a>
                                      </h4>
                                    </div>
                                    <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center text-muted small">
                                      <span>0% complete</span>
                                      <i
                                        class="fa fa-ellipsis-v"
                                        aria-hidden="true"
                                      />
                                    </div>
                                  </div>
                                </div>
                              </div>
                            ))
                          }
                        </div>

                        <div
                          id="no-courses-message"
                          class="p-4 text-center text-muted d-none"
                        >
                          <p class="mt-3">
                            No courses found matching your criteria
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="footer"></div>
              </div>
            </div>
          </section>

          <span id="sb-3"></span>
        </section>
      </div>
    </div>
  </div>

  <LeftColumn siteUrl={siteUrl}>
    <QuickLinks siteUrl={siteUrl} />
  </LeftColumn>
  <RightColumn siteUrl={siteUrl} />
</Layout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("searchinput-mycourses");
    const clearBtn = document.getElementById("clear-search-btn");
    const courseItems = document.querySelectorAll(".course-card-item");
    const noCoursesMsg = document.getElementById("no-courses-message");

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        if (query.length > 0) {
          clearBtn?.classList.remove("d-none");
        } else {
          clearBtn?.classList.add("d-none");
        }

        courseItems.forEach((item) => {
          const name = item.getAttribute("data-course-name") || "";
          const instructor = item.getAttribute("data-course-instructor") || "";
          if (name.includes(query) || instructor.includes(query)) {
            item.classList.remove("d-none");
            visibleCount++;
          } else {
            item.classList.add("d-none");
          }
        });

        if (visibleCount === 0 && query.length > 0) {
          noCoursesMsg?.classList.remove("d-none");
        } else {
          noCoursesMsg?.classList.add("d-none");
        }
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchInput.dispatchEvent(new Event("input"));
          searchInput.focus();
        }
      });
    }
  });
</script>
